<article class="event-card">
  <img class="event-card__image" src="<%= event.image %>" alt="<%= event.title %>" />

  <div class="event-card__body">
    <div class="event-card__date">
      <span><%= event.date.split('-').reverse().join('.') %></span>
      <span><%= event.time %></span>
    </div>

    <h3><%= event.title %></h3>

    <p class="event-card__location"><%= event.city %>, <%= event.address %></p>

    <div class="event-card__actions">
      <a class="btn btn--small" href="/item/<%= event.id %><%= authQuery %>">
        подробнее
      </a>
    </div>
  </div>
</article>
